{
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript][typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "files.eol": "\n"
  },
  "[javascriptreact][typescriptreact]": {
    "editor.tabSize": 2,
    "files.eol": "\n"
  },
  // https://prettier.io/docs/options#print-width によるとデフォルトの80がいいとのこと
  // "prettier.printWidth": 120,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.endOfLine": "lf",
    "prettier.trailingComma": "none"
  },
  "[jsonl]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.endOfLine": "lf",
    "prettier.trailingComma": "none"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "diffEditor.ignoreTrimWhitespace": false
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  // うまくいかないので一旦あきらめる
  // "[php]": {
  //   "editor.defaultFormatter": "persoderlind.vscode-phpcbf",
  //   "editor.formatOnSave": true
  // },
  // "phpcbf.executablePath": "${workspaceFolder}/vendor/bin/phpcbf",
  // "phpcs.executablePath": "${workspaceFolder}/vendor/bin/phpcs",
  // "phpcs.standard": "PSR12",
  // "phpcbf.standard": "PSR12",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "files.eol": "\n"
  },
  "[sql]": {
    "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
  },
  "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "autoDocstring.docstringFormat": "numpy",
  "autoDocstring.startOnNewLine": true,
  "bashBeautify.tabSize": 4,
  "cSpell.enabledFileTypes": {
    "groovy": true,
    "ini": true
  },
  "cSpell.userWords": [
    "dont",
    "sqlfluff"
  ],
  "chat.tools.terminal.autoApprove": {
    "make": true,
    "poetry": true
  },
  "claudeCode.preferredLocation": "panel",
  "database-client.autoSync": true,
  "diffEditor.renderSideBySide": true,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.rulers": [40, 80, 88, 120, 160, 200],
  "editor.tabCompletion": "on",
  // shell-format を最新の 7.2.8 にするとフォーマットできない問題があるので、7.2.5 に据え置きにするための設定
  // https://github.com/foxundermoon/vs-shell-format/issues/396
  "extensions.autoUpdate": "on",
  // これをオンにしなくてもデフォルトで Git Bash に login した状態でターミナルが開く
  // VSCode 内でパスがおかしい（C:\Users が C\x3a\Users になるとか、ssh-agent がおかしい）ときはインタープリタの切り替えをすると直ることがおおいっぽい
  // とにかく 2025.05 時点で ssh-agent の調子がおかしい（毎回 pull するときに ssh-agent のパスワードを聞かれる）のと、
  // Git Bash でホームディレクトリがなぞにエスケープされる現象があった。
  // "terminal.integrated.profiles.windows": {
  //     "Git Bash": {
  //         "path": "C:\\Program Files\\Git\\bin\\bash.exe",
  //         "color": "terminal.ansiCyan",
  //         // "path": "/c/Program\\ Files/Git/bin/bash.exe",
  //         "args": [
  //             "--login",
  //             "-i"
  //         ],
  //     },
  // },
  "files.exclude": {
    "**/.git": false
  },
  "files.trimTrailingWhitespace": true,
  "git.enableSmartCommit": true,
  "git.inputValidation": true,
  "git.inputValidationLength": 72,
  "git.inputValidationSubjectLength": 50,
  "github.copilot.chat.localeOverride": "ja",
  "github.copilot.enable": {
    "markdown": true,
    "textEditor": true,
    "chat": true
  },
  "gitlens.graph.minimap.enabled": false,
  "hediet.vscode-drawio.resizeImages": null,
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "calendar",
    "com_dotnet",
    "Core",
    "ctype",
    "curl",
    "date",
    "dba",
    "dom",
    "enchant",
    "exif",
    "fdfind",
    "FFI",
    "fileinfo",
    "filter",
    "fpm",
    "ftp",
    "gd",
    "gettext",
    "gmp",
    "hash",
    "iconv",
    "imap",
    "intl",
    "json",
    "ldap",
    "libxml",
    "mbstring",
    "meta",
    "mysqli",
    "oci8",
    "odbc",
    "openssl",
    "pcntl",
    "pcre",
    "PDO",
    "pgsql",
    "Phar",
    "posix",
    "pspell",
    "random",
    "readline",
    "Reflection",
    "session",
    "shmop",
    "SimpleXML",
    "snmp",
    "soap",
    "sockets",
    "sodium",
    "SPL",
    "sqlite3",
    "standard",
    "superglobals",
    "sysvmsg",
    "sysvsem",
    "sysvshm",
    "tidy",
    "tokenizer",
    "xml",
    "xmlreader",
    "xmlrpc",
    "xmlwriter",
    "xsl",
    "Zend OPcache",
    "zip",
    "zlib",
    "redis",
    "memcached",
    "apcu"
  ],
  "isort.args": ["--profile", "black"],
  "japanese-proofreading.textlint.かっこ類と隣接する文字の間のスペースの有無": false,
  "markdownlint.configFile": "${userHome}/dotfiles/vscode-settings/extension-config/.markdownlint-cli2.jsonc",
  "omnisharp.useModernNet": true,
  "python.analysis.typeCheckingMode": "basic",
  "redhat.telemetry.enabled": true,
  "security.allowedUNCHosts": ["wsl.localhost"],
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "open",
  "shellcheck.enable": true,
  // sqlfluff(VSCode SQL formatter and linter 拡張機能とは別で CLI のインストールも必要)
  "sqlfluff.dialect": "postgres",
  "sqlfluff.format.enabled": true,
  "sqlfluff.format.languages": [
    "sql",
    "sql-bigquery",
    "jinja-sql",
    "snowflake-sql"
  ],
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "tombi.path": "~/AppData/Local/mise/installs/tombi/1.11.2/tombi.exe",
  "window.customTitleBarVisibility": "windowed",
  // editor.rulers のレンダリングが表示される値に調整している
  // zoomLevel を -2.5 より小さくするとターミナルの文字がつぶれて見えるようになる
  "window.zoomLevel": -2.452,
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#6666"
  },
  "workbench.editor.limit.value": 40,
  "workbench.editor.wrapTabs": true
  // "terminal.integrated.shellIntegration.enabled": false // 要るか要らないか判定中
  // "workbench.editor.tabSizing": "shrink",
}
