{
  "[csharp]": {
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  // docker-compose.yml
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "keep",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[html]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.endOfLine": "lf",
    "prettier.trailingComma": "none",
    "editor.formatOnSave": true
  },
  "[jsonl]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.endOfLine": "lf",
    "prettier.trailingComma": "none",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "keep",
    "gitlens.codeLens.scopes": ["document"],
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },
  "agq.pinnedModels": ["MODEL_PLACEHOLDER_M37"],
  "black-formatter.args": ["--line-length=88"],
  // code-runner : https://murabitoleg.com/vscode-runner/
  // "code-runner.clearPreviousOutput": true,
  "code-runner.runInTerminal": true,
  "color-picker-universal.avoidDuplicate": true,
  "diffEditor.codeLens": true,
  "docker.extension.enableComposeLanguageServer": false,
  "editor.acceptSuggestionOnEnter": "off", // エンターキーでの補完を無効にする
  "editor.accessibilitySupport": "auto",
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "all",
  "editor.rulers": [40, 80, 88, 120, 160, 200], // 垂直ルーラーの表示
  "emmet.includeLanguages": {
    "vue-html": "html"
  },
  "emmet.triggerExpansionOnTab": true, // これをオンにしないと ctrl + e が効かない
  "emmet.variables": {
    "lang": "ja"
  },
  "explorer.confirmPasteNative": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.csproj": "${capture}.csproj.user",
    "*.json": "${capture}.Development.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.xaml": "${capture}.xaml.cs",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "explorer.openEditors.sortOrder": "alphabetical",
  // 言語認識の関連付け
  "files.associations": {
    "*.txt": "Markdown",
    "*.jslib": "javascript",
    "*.conf": "nginx",
    "nginx.conf": "nginx",
    "*.jsonc": "jsonc"
  },
  "files.exclude": {
    "**/.git": false,
    "**/*.meta": true,
    "**/*.out": true
  },
  "files.insertFinalNewline": true, // 最終行は改行にする
  "geminicodeassist.displayInlineContextHint": false,
  "git.suggestSmartCommit": false,
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "scminput": true,
    "plaintext": true
  },
  "japanese-proofreading.textlint.助詞の連続": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "makefile.configureOnOpen": true,
  "markdown-pdf.displayHeaderFooter": false,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "omnisharp.monoPath": "/Library/Frameworks/Mono.framework/Versions/Current/Commands/mono",
  "omnisharp.path": "latest",
  "omnisharp.useGlobalMono": "always",
  "omnisharp.useModernNet": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "python.languageServer": "Default",
  "redhat.telemetry.enabled": true,
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true
  },
  "security.workspace.trust.untrustedFiles": "open",
  "shellcheck.customArgs": ["-x"],
  "tabnine.experimentalAutoImports": true,
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.detectLocale": "auto",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": ["-l"],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh",
      "args": ["-l"]
    },
    "fish": {
      "path": "fish",
      "args": ["-l"]
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    },
    "dash": {
      "path": "/bin/dash"
    }
  },
  "terminal.integrated.unicodeVersion": "11",
  "terraform.languageServer.enable": true,
  "todohighlight.keywords": [
    {
      "text": "TODO :",
      "color": "red",
      "border": "1px solid red",
      "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
      "backgroundColor": "rgba(0,0,0,.2)"
    },
    {
      "text": "NOTE :",
      "color": "#fff",
      "backgroundColor": "#4c26"
    }
  ],
  "window.zoomLevel": -0.85,
  "workbench.editor.wrapTabs": false,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
