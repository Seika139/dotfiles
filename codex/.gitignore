mise.local.toml
__pycache__/

# Codex runtime config is generated at ~/.codex/config.toml from
# profile config.base.toml + optional local/private overrides.
config.toml
config.local.toml
config.local.toml.backup.*
config.base.toml.backup.*

# Codex runtime hooks are generated at ~/.codex/hooks.json from
# profile hooks.base.json + optional local/private overrides.
profiles/*/hooks.local.json

create-issue-config.json

# Codex notification debug logs generated per profile.
profiles/*/notify.log

# skill-creator が作る一時コピーを無視する。
**/skills/*-skill-*/
**/prompts/*-skill-*.md
**/skills/*-workspace/
